<Window x:Class="PptPoc.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initializing POC..." Height="200" Width="400"
        WindowStyle="None" WindowStartupLocation="CenterScreen" 
        Background="#1E1E1E" Foreground="White" AllowsTransparency="True" Topmost="True">
    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="PPT Presentation POC" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Starting initialization..." HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#AAAAAA"/>
            
            <ProgressBar x:Name="DownloadProgressBar" Grid.Row="2" Height="15" Minimum="0" Maximum="100" />
        </Grid>
    </Border>
</Window>