{
  // Copy this file to appsettings.local.json and fill in your values.
  // appsettings.local.json is gitignored and will override these defaults at runtime.
  // The base appsettings.json already has correct defaults for Intel internal use.
  "AppConfig": {
    // ── LLM / Vision ──────────────────────────────────────────────────────────
    // Intel GNAI gateway (Anthropic proxy).  Set GNAI_TOKEN env var for auth.
    "OpenAIBaseUrl": "https://gnai.intel.com/api/providers/anthropic/v1",
    "OpenAIModel": "claude-4-8-opus",
    "VisionProvider": "anthropic",             // "anthropic" | "openai"

    // ── ASR / Models ──────────────────────────────────────────────────────────
    "ParakeetModelPath": "models/parakeet",    // path to OpenVINO Parakeet-TDT model
    "OpenVinoDevice": "GPU",                   // "CPU" | "GPU" | "NPU"
    "ForceCpuMode": false,

    // ── Audio Capture ─────────────────────────────────────────────────────────
    "AudioDeviceIndex": 0,                     // 0 = default mic
    "AudioChunkMs": 250,

    // ── ASR Pipeline ──────────────────────────────────────────────────────────
    "AsrBufferSeconds": 10,
    "AsrTranscriptionWindowSeconds": 5,
    "AsrMinStepMs": 250,
    "TranscriptWindowSeconds": 10,

    // ── Matching & Highlighting ───────────────────────────────────────────────
    "MatchConfidenceThreshold": 0.2,
    "HighlightDurationMs": 2000,
    "CooldownMs": 700,
    "GlobalCooldownMs": 200,
    "StabilityRequiredCycles": 1,
    "HighlightColorText": "#FFFF00",
    "HighlightColorImage": "#00BFFF",
    "HighlightBorderWeight": 4,

    // ── Infrastructure ────────────────────────────────────────────────────────
    "LogFilePath": "logs/pptpoc-.log",
    "OrchestratorLoopMs": 100,
    "LaserToggleHotkey": "Ctrl+Shift+L"
  }
}
