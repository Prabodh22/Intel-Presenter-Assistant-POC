<Window x:Class="PptPoc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPT Speaker Highlight POC" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
    Loaded="OnLoaded"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="PPT Speaker Highlight" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Status -->
        <Border Grid.Row="1" Background="#F0F0F0" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready — open PowerPoint and click Start" TextWrapping="Wrap"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="10" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="Start" Width="80" Height="30" Margin="0,0,8,0"
                    Click="StartButton_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="StopButton" Content="Stop" Width="80" Height="30" Margin="0,0,8,0"
                    Click="StopButton_Click" Background="#F44336" Foreground="White" FontWeight="Bold" IsEnabled="False"/>
            <TextBlock x:Name="SlideInfo" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Live Transcript -->
        <GroupBox Grid.Row="3" Header="Live Transcript" Margin="0,0,0,8">
            <ScrollViewer x:Name="TranscriptScroller" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranscriptText" TextWrapping="Wrap" Padding="4"
                           Foreground="#333333" FontSize="13"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Label -->
        <TextBlock Grid.Row="4" Text="Highlight Log" FontWeight="SemiBold" Margin="0,0,0,4"/>

        <!-- Highlight Log -->
        <ListBox Grid.Row="5" x:Name="HighlightLog" FontSize="11" Foreground="#555555"/>
    </Grid>
</Window>
