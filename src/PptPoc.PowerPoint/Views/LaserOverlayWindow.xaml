<Window x:Class="PptPoc.PowerPoint.Views.LaserOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaserOverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">
    <Canvas Name="OverlayCanvas">

        <!-- ① Original laser dot – used for whole-image / fallback highlights -->
        <Ellipse Name="LaserDot"
                 Width="16" Height="16"
                 Fill="#FFFF1111"
                 Visibility="Collapsed"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFFF0000" BlurRadius="12" ShadowDepth="0" Opacity="1"/>
            </Ellipse.Effect>
        </Ellipse>

        <!--
            ② OCR word-level highlight rect – shown instead of the dot when the
            matcher found specific OCR words inside the image and confidence >= 0.5.
            Position/size and stroke properties are set entirely from code-behind.
        -->
        <Rectangle Name="OcrHighlightRect"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Fill="Transparent"
                   StrokeThickness="3"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Width="100"
                   Height="30">
            <Rectangle.Effect>
                <DropShadowEffect x:Name="OcrGlowEffect"
                                  Color="#00BFFF"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.9"/>
            </Rectangle.Effect>
        </Rectangle>

    </Canvas>
</Window>
