# ============================================================
# Runtime-Generated Knowledge Base Files
# These are preprocessed PPTX artifacts tied to local machine
# paths; they can be hundreds of MB and contain raw embeddings.
# Regenerated automatically on first run via KnowledgeBasePreprocessor.
# ============================================================
knowledge_base*.yaml
knowledge_base*.yml

# ============================================================
# Secrets & Local Config Overrides
# appsettings.json is committed as the base config (no raw keys).
# Put machine-specific overrides and secrets in appsettings.local.json
# which is gitignored. See appsettings.example.json for the template.
# ============================================================
appsettings.local.json
appsettings.Development.json
secrets.json
.env
.env.*
*.pfx
*.p12

# ============================================================
# Models & Large Binary Assets
# OpenVINO / ONNX model weights — download separately per README
# ============================================================
/models/
*.onnx
*.xml
*.bin
*.pt
*.pth

